# Copy this file to .env and fill it in. .env is ignored by git; never commit real secrets.

# Fetch plant photos and descriptions from Wikipedia when a plant is added (on/off). Default: on
ONLINE_PHOTOS=on

# Google reminders (optional). Without both of these the app works, just without reminders.
# The address of your deployed Apps Script web app (see the README, "Google reminders")
GOOGLE_SCRIPT_URL=
# The same long random secret you stored as SHARED_SECRET in the script's properties
GOOGLE_SCRIPT_SECRET=

# How often (minutes) the running app syncs with Google. Default: 10
SYNC_INTERVAL_MINUTES=10
